{
  "title": "PQC IoT Lab Overview",
  "uid": "pqc-iot-overview",
  "schemaVersion": 38,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "tags": ["pqc","iot","mqtt"],
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "PQC TLS Handshake Latency (ms)",
      "gridPos": {"h":8,"w":12,"x":0,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"ms","min":0,"custom":{"lineWidth":2,"fillOpacity":10}}},
      "options": {"legend":{"calcs":["mean","max"],"displayMode":"table","placement":"bottom"}},
      "targets": [{"expr":"handshake_latency_ms","legendFormat":"{{proxy}} ({{algorithm}})","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}}]
    },
    {
      "id": 2, "type": "gauge", "title": "Handshake Latency per Proxy",
      "gridPos": {"h":8,"w":12,"x":12,"y":0},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"ms","min":0,"max":1000,"thresholds":{"mode":"absolute","steps":[{"color":"green","value":null},{"color":"yellow","value":100},{"color":"red","value":500}]}}},
      "options": {"reduceOptions":{"calcs":["lastNotNull"]}},
      "targets": [{"expr":"handshake_latency_ms","legendFormat":"{{proxy}}","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}}]
    },
    {
      "id": 3, "type": "timeseries", "title": "CPU Usage per Node (rate 1m)",
      "gridPos": {"h":8,"w":12,"x":0,"y":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"percentunit","min":0,"max":1,"custom":{"lineWidth":2,"fillOpacity":10}}},
      "targets": [{"expr":"rate(process_cpu_seconds_total[1m])","legendFormat":"{{instance}}","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}}]
    },
    {
      "id": 4, "type": "timeseries", "title": "Resident Memory per Node",
      "gridPos": {"h":8,"w":12,"x":12,"y":8},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"bytes","min":0,"custom":{"lineWidth":2}}},
      "targets": [{"expr":"node_memory_rss_bytes","legendFormat":"{{node_id}}","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}}]
    },
    {
      "id": 5, "type": "timeseries", "title": "MQTT Publish Latency p50/p95",
      "gridPos": {"h":8,"w":12,"x":0,"y":16},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"ms","min":0,"custom":{"lineWidth":2,"fillOpacity":10}}},
      "targets": [
        {"expr":"histogram_quantile(0.95, sum by (le,node_id)(rate(mqtt_publish_latency_ms_bucket[1m])))","legendFormat":"p95 {{node_id}}","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}},
        {"expr":"histogram_quantile(0.50, sum by (le,node_id)(rate(mqtt_publish_latency_ms_bucket[1m])))","legendFormat":"p50 {{node_id}}","refId":"B","datasource":{"type":"prometheus","uid":"prometheus"}}
      ]
    },
    {
      "id": 6, "type": "stat", "title": "MQTT Messages Published",
      "gridPos": {"h":8,"w":12,"x":12,"y":16},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"short","color":{"mode":"thresholds"},"thresholds":{"mode":"absolute","steps":[{"color":"blue","value":null}]}}},
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background","graphMode":"area"},
      "targets": [{"expr":"sum(mqtt_messages_total) by (node_id)","legendFormat":"{{node_id}}","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}}]
    },
    {
      "id": 7, "type": "timeseries", "title": "Network Throughput (bytes/s)",
      "gridPos": {"h":8,"w":24,"x":0,"y":24},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"Bps","min":0,"custom":{"lineWidth":2}}},
      "targets": [
        {"expr":"rate(node_network_transmit_bytes_total{device!~\"lo|veth.*\"}[1m])","legendFormat":"TX {{device}}","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}},
        {"expr":"rate(node_network_receive_bytes_total{device!~\"lo|veth.*\"}[1m])","legendFormat":"RX {{device}}","refId":"B","datasource":{"type":"prometheus","uid":"prometheus"}}
      ]
    },
    {
      "id": 9, "type": "stat", "title": "IoT Nodes Online",
      "gridPos": {"h":4,"w":12,"x":0,"y":32},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]}}},
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},
      "targets": [{"expr":"count(up{job=\"iot_nodes\"} == 1)","legendFormat":"Nodes UP","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}}]
    },
    {
      "id": 10, "type": "stat", "title": "PQC Proxies Online",
      "gridPos": {"h":4,"w":12,"x":12,"y":32},
      "datasource": {"type":"prometheus","uid":"prometheus"},
      "fieldConfig": {"defaults": {"unit":"short","thresholds":{"mode":"absolute","steps":[{"color":"green","value":null}]}}},
      "options": {"reduceOptions":{"calcs":["lastNotNull"]},"colorMode":"background"},
      "targets": [{"expr":"count(up{job=\"pqc_proxy\"} == 1)","legendFormat":"Proxies UP","refId":"A","datasource":{"type":"prometheus","uid":"prometheus"}}]
    }
  ]
}
